# Окружение: development | staging | production
ENVIRONMENT=development
DEBUG=false

# Сервис
SERVICE_NAME=sales-service
PORT=8003

# auth-service JWKS endpoint для верификации JWT.
# Docker: http://auth-service:8000/.well-known/jwks.json
# Локально: http://localhost:8000/.well-known/jwks.json
AUTH_SERVICE_JWKS_URL=http://localhost:8000/.well-known/jwks.json
JWKS_CACHE_TTL_SECONDS=3600
JWT_ALGORITHM=ES256

# HTTP — межсервисные вызовы
# Docker: http://client-service:8001
# Локально: http://localhost:8001
CLIENT_SERVICE_URL=http://localhost:8001

# PostgreSQL — обязательно заполнить
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Kafka Producer
# Несколько брокеров: ["broker1:9092","broker2:9092"]
KAFKA_BOOTSTRAP_SERVERS=["localhost:9092"]
KAFKA_SALE_CREATED_TOPIC=sale_created
# all — запись подтверждается всеми репликами (надёжно, чуть медленнее)
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3

# Скидки по уровням лояльности в процентах (0.0–100.0)
# Обязательно: standard <= bronze <= silver <= gold
LOYALTY_STANDARD_DISCOUNT_PCT=0.0
LOYALTY_BRONZE_DISCOUNT_PCT=3.0
LOYALTY_SILVER_DISCOUNT_PCT=6.0
LOYALTY_GOLD_DISCOUNT_PCT=9.0

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

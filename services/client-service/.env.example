# Окружение: development | staging | production
ENVIRONMENT=development
DEBUG=false

# Сервис
SERVICE_NAME=client-service
PORT=8001

# auth-service JWKS endpoint для верификации JWT.
# Docker: http://auth-service:8000/.well-known/jwks.json
# Локально: http://localhost:8000/.well-known/jwks.json
AUTH_SERVICE_JWKS_URL=http://localhost:8000/.well-known/jwks.json
JWKS_CACHE_TTL_SECONDS=3600
JWT_ALGORITHM=ES256

# PostgreSQL — обязательно заполнить
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis — обязательно заполнить
REDIS_URL=
REDIS_CACHE_DB=0
CLIENT_CACHE_TTL_SECONDS=300

# Kafka Consumer
# Несколько брокеров: ["broker1:9092","broker2:9092"]
KAFKA_BOOTSTRAP_SERVERS=["localhost:9092"]
KAFKA_CONSUMER_GROUP_ID=client-service-group
KAFKA_SALE_CREATED_TOPIC=sale_created
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
# session_timeout_ms > 3 × heartbeat_interval_ms — требование брокера
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=30000
KAFKA_CONSUMER_HEARTBEAT_INTERVAL_MS=10000
# Увеличить если обработка одного сообщения занимает больше 5 минут
KAFKA_CONSUMER_MAX_POLL_INTERVAL_MS=300000

# Система лояльности — пороги (количество подтверждённых продаж)
# Обязательно: bronze < silver < gold, все > 0
LOYALTY_BRONZE_MIN_SALES=1
LOYALTY_SILVER_MIN_SALES=3
LOYALTY_GOLD_MIN_SALES=10

# Система лояльности — скидки в процентах (0.0–100.0)
LOYALTY_STANDARD_DISCOUNT_PCT=0.0
LOYALTY_BRONZE_DISCOUNT_PCT=3.0
LOYALTY_SILVER_DISCOUNT_PCT=6.0
LOYALTY_GOLD_DISCOUNT_PCT=9.0

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

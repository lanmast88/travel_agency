# Окружение
ENVIRONMENT=development
DEBUG=true

# Сервис
SERVICE_NAME=tour-service
PORT=8002

# auth-service JWKS endpoint для верификации JWT
AUTH_SERVICE_JWKS_URL=http://localhost:8000/.well-known/jwks.json
JWKS_CACHE_TTL_SECONDS=3600
JWT_ALGORITHM=ES256

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tour_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=0
TOUR_CACHE_TTL_SECONDS=300

# Kafka
KAFKA_BOOTSTRAP_SERVERS=["localhost:9092"]
KAFKA_TOUR_UPDATES_TOPIC=tour_updated

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
